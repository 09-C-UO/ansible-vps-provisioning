#!/usr/bin/env python3
"""Send an alert to a Discord channel and always record it in the journal.

Usage: notify-discord <infra|security> <title> [body]   (body defaults to stdin)
Webhook URLs are read from /etc/notify-discord.env (root only).
"""
import json
import socket
import subprocess
import sys
import urllib.request

ENV_FILE = "/etc/notify-discord.env"
CHANNELS = {"infra": "DISCORD_WEBHOOK_INFRA", "security": "DISCORD_WEBHOOK_SECURITY"}
DISCORD_LIMIT = 1900  # Discord refuses messages over 2000 characters.


def read_env(path):
    values = {}
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                key, sep, value = line.strip().partition("=")
                if sep and not key.startswith("#"):
                    values[key] = value
    except FileNotFoundError:
        pass
    return values


def main():
    if len(sys.argv) not in (3, 4) or sys.argv[1] not in CHANNELS:
        sys.exit(__doc__)
    channel, title = sys.argv[1], sys.argv[2]
    body = sys.argv[3] if len(sys.argv) == 4 else sys.stdin.read()
    host = socket.gethostname()

    subprocess.run(["logger", "-t", "notify-discord", "-p", "user.warning",
                    f"[{channel}] {title}"], check=False)

    url = read_env(ENV_FILE).get(CHANNELS[channel], "")
    if not url:
        return
    text = f"**[{host}] {title}**"
    if body.strip():
        # Callers put the most useful lines first: keep the beginning.
        room = DISCORD_LIMIT - len(text) - 12
        body = body.strip()
        if len(body) > room:
            body = body[:room - 2] + "\n…"
        text += "\n```\n" + body + "\n```"
    # allowed_mentions: a log line containing @everyone must not ping anyone.
    payload = json.dumps({"content": text, "allowed_mentions": {"parse": []}}).encode()
    request = urllib.request.Request(url, data=payload, method="POST",
                                     headers={"Content-Type": "application/json",
                                              "User-Agent": "notify-discord"})
    try:
        urllib.request.urlopen(request, timeout=15).close()
    except OSError as error:
        subprocess.run(["logger", "-t", "notify-discord", "-p", "user.err",
                        f"delivery failed: {error}"], check=False)
        sys.exit(1)


if __name__ == "__main__":
    main()
