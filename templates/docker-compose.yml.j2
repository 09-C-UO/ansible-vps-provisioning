# Managed by Ansible.
name: traefik

services:
  traefik:
    image: {{ traefik_image }}
    restart: unless-stopped
    user: "65534:65534"
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp
{% if acme_challenge == 'dns' %}
    env_file:
      - ./acme-dns.env
{% endif %}
    ports:
      - "80:8080"
      - "443:8443"
    volumes:
      - ./traefik.yml:/etc/traefik/traefik.yml:ro
      # A directory, not files: a file mount would keep pointing at the old
      # inode after Ansible replaces the file, and watch would see nothing.
      - ./dynamic:/etc/traefik/dynamic:ro
      - ./users.htpasswd:/etc/traefik/users.htpasswd:ro
      - ./acme:/acme
      - ./logs:/logs
    networks:
      - edge

# Applications attach their web service to this network (compose.edge.yml).
networks:
  edge:
    name: edge
