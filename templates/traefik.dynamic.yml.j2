# Managed by Ansible. Routes, middlewares and services.
http:
  routers:
    coucou:
      rule: "Host(`{{ traefik_effective_domain }}`)"
      entryPoints:
        - websecure
      # Headers first, so they are also sent on 401 responses.
      middlewares:
        - security-headers
        - rate-limit
        - coucou-auth
      service: coucou
      tls:
        certResolver: le

  middlewares:
    coucou-auth:
      basicAuth:
        usersFile: /etc/traefik/users.htpasswd
        realm: coucou
    # Per client IP. Slows bursts; fail2ban handles slow brute force.
    rate-limit:
      rateLimit:
        average: 20
        burst: 40
    security-headers:
      headers:
        stsSeconds: 31536000
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: no-referrer

  services:
    coucou:
      loadBalancer:
        servers:
          - url: "http://coucou:8080"

tls:
  options:
    default:
      minVersion: VersionTLS12
