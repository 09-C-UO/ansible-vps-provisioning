# Copier en prod.tfvars (ignoré par git) et compléter.
scaleway_organization_id = "11111111-1111-1111-1111-111111111111"
scaleway_project_id      = "11111111-1111-1111-1111-111111111111"
scaleway_region          = "fr-par"
scaleway_zone            = "fr-par-1"

name           = "app-prod"
instance_type  = "PLAY2-PICO15"
root_volume_size = 20
ssh_port       = 22222

# SSH restreint à une IP fixe ou un VPN :
# trusted_ssh_cidr = "203.0.113.10/32"

# Après le bootstrap Ansible (sshd déplacé, root verrouillé), fermer le 22 :
# ssh_22_open = false
